{
  "info": {
    "name": "Recruitment Platform",
    "description": "Auth and Candidate microservices for the internship project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register HR",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hr@company.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"HR\"\n}"
            },
            "url": "{{auth_base_url}}/api/auth/register/hr"
          }
        },
        {
          "name": "Register Interviewer",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"interviewer@company.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Interviewer\"\n}"
            },
            "url": "{{auth_base_url}}/api/auth/register/interviewer"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const token = json.accessToken || json.token;",
                  "    if (token) {",
                  "        pm.environment.set('access_token', token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hr@company.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{auth_base_url}}/api/auth/login"
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{auth_base_url}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Candidates",
      "item": [
        {
          "name": "Create Candidate",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Smith\",\n  \"email\": \"alice@example.com\",\n  \"phone\": \"+1234567890\",\n  \"tags\": [\"java\", \"spring\"]\n}"
            },
            "url": "{{candidate_base_url}}/api/candidates"
          }
        },
        {
          "name": "List Candidates",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{candidate_base_url}}/api/candidates"
          }
        },
        {
          "name": "Search Candidates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{candidate_base_url}}/api/candidates/search?tag=java",
              "host": ["{{candidate_base_url}}"],
              "path": ["api", "candidates", "search"],
              "query": [
                { "key": "tag", "value": "java" }
              ]
            }
          }
        },
        {
          "name": "Upload CV",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{candidate_base_url}}/api/candidates/1/cv"
          }
        },
        {
          "name": "Update Application Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"INTERVIEW\"\n}"
            },
            "url": "{{candidate_base_url}}/api/candidates/1/status"
          }
        }
      ]
    }
  ]
}
