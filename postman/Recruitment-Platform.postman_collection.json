{
  "info": {
    "name": "Recruitment Platform",
    "description": "Local APIs: auth :8081, candidates :8082, applications :8083.\n\nSetup:\n1. Import this collection and Local.postman_environment.json\n2. Select environment Local\n3. Run Auth → Login (HR) — saves access_token\n\nDemo logins (password password123):\n- hr@company.com\n- admin@company.com\n- interviewer@company.com\n- ldap.hr@company.com\n\nEnvironment already has seeded Alice / Java Engineer / application IDs. Create requests use new emails/titles so they do not conflict with seed data.\n\nCV samples (PDF): samples/cv/Abdullah_Emad_Resume.pdf, Alice_Smith_CV.pdf, Bob_Jones_CV.pdf.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (HR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const token = json.accessToken || json.token;",
                  "    if (token) {",
                  "        pm.environment.set('access_token', token);",
                  "    } else {",
                  "        pm.environment.unset('access_token');",
                  "    }",
                  "} else {",
                  "    pm.environment.unset('access_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hr@company.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{auth_base_url}}/api/auth/login",
            "description": "Default demo login. Saves access_token."
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const token = json.accessToken || json.token;",
                  "    if (token) {",
                  "        pm.environment.set('access_token', token);",
                  "    } else {",
                  "        pm.environment.unset('access_token');",
                  "    }",
                  "} else {",
                  "    pm.environment.unset('access_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@company.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{auth_base_url}}/api/auth/login",
            "description": "Needed for register endpoints."
          }
        },
        {
          "name": "Login (Interviewer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const token = json.accessToken || json.token;",
                  "    if (token) {",
                  "        pm.environment.set('access_token', token);",
                  "    } else {",
                  "        pm.environment.unset('access_token');",
                  "    }",
                  "} else {",
                  "    pm.environment.unset('access_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"interviewer@company.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{auth_base_url}}/api/auth/login",
            "description": "Use before My Assignments / Create Evaluation. interviewer_user_id is already in the Local env."
          }
        },
        {
          "name": "Login (LDAP HR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const token = json.accessToken || json.token;",
                  "    if (token) {",
                  "        pm.environment.set('access_token', token);",
                  "    } else {",
                  "        pm.environment.unset('access_token');",
                  "    }",
                  "} else {",
                  "    pm.environment.unset('access_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ldap.hr@company.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{auth_base_url}}/api/auth/login",
            "description": "Requires OpenLDAP container on port 1389."
          }
        },
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.id && json.role === 'INTERVIEWER') {",
                  "        pm.environment.set('interviewer_user_id', json.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "url": "{{auth_base_url}}/api/auth/me"
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "url": "{{auth_base_url}}/api/auth/users/{{interviewer_user_id}}",
            "description": "HR/ADMIN only."
          }
        },
        {
          "name": "Register HR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.hr@company.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"Nina\",\n  \"lastName\": \"Recruiter\"\n}"
            },
            "url": "{{auth_base_url}}/api/auth/register/hr",
            "description": "ADMIN only. Login (Admin) first."
          }
        },
        {
          "name": "Register Interviewer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.interviewer@company.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"Omar\",\n  \"lastName\": \"Interviewer\"\n}"
            },
            "url": "{{auth_base_url}}/api/auth/register/interviewer",
            "description": "ADMIN only. Login (Admin) first."
          }
        },
        {
          "name": "Register LDAP HR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ldap.new.hr@company.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"Lara\",\n  \"lastName\": \"LDAP\"\n}"
            },
            "url": "{{auth_base_url}}/api/auth/register/ldap/hr",
            "description": "ADMIN only. Creates LDAP + auth_db user."
          }
        },
        {
          "name": "Register LDAP Interviewer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ldap.new.interviewer@company.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"Sam\",\n  \"lastName\": \"LDAP\"\n}"
            },
            "url": "{{auth_base_url}}/api/auth/register/ldap/interviewer",
            "description": "ADMIN only. Creates LDAP + auth_db user."
          }
        }
      ]
    },
    {
      "name": "Candidates",
      "item": [
        {
          "name": "Create Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.id) {",
                  "        pm.environment.set('candidate_id', json.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Carol\",\n  \"lastName\": \"Nguyen\",\n  \"email\": \"carol@example.com\",\n  \"phone\": \"+15559876543\",\n  \"tags\": [\"java\", \"kafka\"]\n}"
            },
            "url": "{{candidate_base_url}}/api/candidates",
            "description": "Uses carol@example.com so it does not conflict with seeded Alice/Bob."
          }
        },
        {
          "name": "List Candidates",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const items = json.items || json;",
                  "    if (Array.isArray(items) && items.length > 0 && items[0].id) {",
                  "        pm.environment.set('candidate_id', items[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "url": {
              "raw": "{{candidate_base_url}}/api/candidates?tag=java",
              "host": ["{{candidate_base_url}}"],
              "path": ["api", "candidates"],
              "query": [
                { "key": "tag", "value": "java", "description": "Optional. Disable to list all." }
              ]
            }
          }
        },
        {
          "name": "Get Candidate",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "url": "{{candidate_base_url}}/api/candidates/{{candidate_id}}"
          }
        },
        {
          "name": "Update Candidate",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+1234567890\",\n  \"talentStatus\": \"IN_POOL\",\n  \"tags\": [\"java\", \"senior\"]\n}"
            },
            "url": "{{candidate_base_url}}/api/candidates/{{candidate_id}}"
          }
        },
        {
          "name": "Delete Candidate",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "url": "{{candidate_base_url}}/api/candidates/{{candidate_id}}",
            "description": "Soft delete. Returns 204. Prefer deleting Carol, not seeded Alice, if you still need demo hiring data."
          }
        },
        {
          "name": "Upload CV",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Attach samples/cv/Abdullah_Emad_Resume.pdf (or Alice_Smith_CV.pdf / Bob_Jones_CV.pdf)"
                }
              ]
            },
            "url": "{{candidate_base_url}}/api/candidates/{{candidate_id}}/cv",
            "description": "form-data field name: file."
          }
        },
        {
          "name": "Bulk Upload CVs",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Attach samples/cv/Alice_Smith_CV.pdf"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Optional second file: samples/cv/Bob_Jones_CV.pdf"
                }
              ]
            },
            "url": "{{candidate_base_url}}/api/candidates/cv/bulk",
            "description": "Multipart form-data, field name files (repeatable)."
          }
        }
      ]
    },
