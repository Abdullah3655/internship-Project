                  "    const items = json.items || [];",
                  "    if (items.length > 0) {",
                  "        if (items[0].id) pm.environment.set('assignment_id', items[0].id);",
                  "        if (items[0].applicationId) pm.environment.set('application_id', items[0].applicationId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "url": "{{application_base_url}}/api/assignments",
            "description": "INTERVIEWER only. Login (Interviewer) first."
          }
        },
        {
          "name": "Create Evaluation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.id) {",
                  "        pm.environment.set('evaluation_id', json.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"score\": 4,\n  \"feedback\": \"Strong Java skills\"\n}"
            },
            "url": "{{application_base_url}}/api/applications/{{application_id}}/evaluations",
            "description": "INTERVIEWER only. Must be assigned to this application. Login (Interviewer) first."
          }
        },
        {
          "name": "List Evaluations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const items = json.items || [];",
                  "    if (items.length > 0 && items[0].id) {",
                  "        pm.environment.set('evaluation_id', items[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "url": "{{application_base_url}}/api/applications/{{application_id}}/evaluations"
          }
        },
        {
          "name": "Delete Evaluation",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "url": "{{application_base_url}}/api/applications/{{application_id}}/evaluations/{{evaluation_id}}",
            "description": "Set evaluation_id via Create Evaluation or List Evaluations."
          }
        },
        {
          "name": "Delete Assignment",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "url": "{{application_base_url}}/api/applications/{{application_id}}/assignments/{{assignment_id}}",
            "description": "Set assignment_id via List Assignments."
          }
        },
        {
          "name": "Delete Application",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "url": "{{application_base_url}}/api/applications/{{application_id}}",
            "description": "Removes application and related stage events, assignments, evaluations."
          }
        },
        {
          "name": "Change Stage to HIRED",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json;version={{api_version}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toStage\": \"HIRED\",\n  \"note\": \"Offer accepted\"\n}"
            },
            "url": "{{application_base_url}}/api/applications/{{application_id}}/stage-changes",
            "description": "Also sets candidate talentStatus to HIRED in candidate-service."
          }
        }
      ]
    }
  ]
}
